# local/snippets/post_start.custom
# Disable disk core dumper so ASIL-D fail-operational process respawn is not blocked by IDE disk I/O
slay -f dumper >/dev/null 2>&1

echo "=================================================="
echo " Executing SafePulse Pre-Flight ASIL-D Benchmarks"
echo "=================================================="
/proc/boot/test_autosar_e2e
/proc/boot/test_mcdc_matrix
/proc/boot/test_can_ingress
/proc/boot/benchmark_wcet
echo "=== SAFEPULSE_SDK_VERIFICATION_START ==="
/proc/boot/test_sdk_rules
/proc/boot/example_minimal
/proc/boot/example_custom_rules
echo "=== SAFEPULSE_SDK_VERIFICATION_END ==="

echo "=================================================="
echo " Starting SafePulse Self-Healing Watcher (HAM)"
echo "=================================================="
SAFEPULSE_SECURE=1
export SAFEPULSE_SECURE
on -T safepulse_watcher_t -u 421:428 /proc/boot/safepulse_watcher &
sleep 2

echo "=================================================="
echo " Starting SafePulse TCP Bridge (Port 9876)"
echo "=================================================="
on -T safepulse_bridge_t -u 422:428 /proc/boot/safepulse_bridge &
sleep 1

echo "=================================================="
echo " Starting SafePulse Multi-ECU Autonomous Nodes"
echo "=================================================="
on -T safepulse_steering_t -u 422:428 /proc/boot/ecu_steering &
on -T safepulse_braking_t -u 422:428 /proc/boot/ecu_braking &
on -T safepulse_power_t -u 422:428 /proc/boot/ecu_powertrain &
